{
    // Example: simple shop NPC with explicit custom talkflow assignment.
    // Replace this CharacterId with your target NPC row name.
    "Village_Merchant_Test": {
        "Name": "Village Merchant (Custom Flow)",

        "Shop": {
            "CanSell": true,
            "ShopTableId": "Village_Merchant_Test_Shop",
            "Currency": "Money",
            "Items": [
                {
                    "StaticItemId": "Pal_crystal_S",
                    "ProductType": "EPalItemShopProductType::Normal",
                    "OverridePrice": 0,
                    "ProductNum": 5,
                    "Stock": 0
                },
                {
                    "StaticItemId": "Stone",
                    "ProductType": "EPalItemShopProductType::Normal",
                    "OverridePrice": 0,
                    "ProductNum": 10,
                    "Stock": 0
                }
            ]
        },

        // This overrides the default static shop talkflow assignment.
        // In this example we point it to the bounty-style flow for demonstration.
        "TalkFlowAssetPath": "/Game/Pal/Blueprint/FlowGraph/NPCTalkFlow/Graph/FABP_CommonBountyTrader.FABP_CommonBountyTrader"
    }
}
